+#include <emmintrin.h>
+static INLINE int fast_word_has_ff(bit_buf_type word)
+{
+  __m128i bytes = _mm_cvtsi64_si128((long long)word);
+  return _mm_movemask_epi8(_mm_cmpeq_epi8(bytes, _mm_set1_epi8(-1)));
