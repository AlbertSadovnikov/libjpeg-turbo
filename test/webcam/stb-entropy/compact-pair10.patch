+           (*e & 0xf00U) | ((unsigned int)(step - 1) << 12) |
+           16U | (unsigned int)used;
+    }
+  }
+  memcpy(cache->bits, h->bits, sizeof(cache->bits));
+  memcpy(cache->huffval, h->huffval, sizeof(cache->huffval));
+  cache->valid = TRUE;
+  return cache->lookup;
+}
