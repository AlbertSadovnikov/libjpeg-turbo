+LOCAL(const multi_entry *)
+get_fused_ac_lookup(j_decompress_ptr cinfo, int tblno)
+{
+  JHUFF_TBL *h = cinfo->ac_huff_tbl_ptrs[tblno];
+  fused_ac_cache *cache = (fused_ac_cache *)cinfo->master->fused_ac_cache[tblno];
