+/* Experimental x86-64/BMI2 kernels. Counts and block positions are supplied
+ * by the existing fast decoder. Refill and malformed-input fallback stay in C.
+ * Non-volatile asm: explicit inputs/outputs; cc and memory clobbers as needed. */
+static inline int
+mjpeg_receive_asm(bit_buf_type word, int *available, unsigned int n)
+{
+  int left = *available;
+  bit_buf_type value;
+  unsigned int threshold, count, negative;
+  __asm__(
+    "sub {%k[n], %k[left]|%k[left], %k[n]}\n\t"
+    "shrx {%q[left], %[word], %[value]|%[value], %[word], %q[left]}\n\t"
+    "bzhi {%[n], %k[value], %k[value]|%k[value], %k[value], %[n]}\n\t"
+    "lea {-1(%[n]), %[count]|%[count], [%[n]-1]}\n\t"
+    "mov {$1, %[threshold]|%[threshold], 1}\n\t"
+    "shlx {%[count], %[threshold], %[threshold]|%[threshold], %[threshold], %[count]}\n\t"
+    "cmp {%[threshold], %k[value]|%k[value], %[threshold]}\n\t"
+    "sbb {%[negative], %[negative]|%[negative], %[negative]}\n\t"
+    "lea {-1(%[threshold],%[threshold]), %[threshold]|%[threshold], [%[threshold]+%[threshold]-1]}\n\t"
+    "and {%[negative], %[threshold]|%[threshold], %[negative]}\n\t"
+    "sub {%[threshold], %k[value]|%k[value], %[threshold]}"
+    : [left] "+&r" (left), [value] "=&r" (value),
+      [threshold] "=&r" (threshold), [count] "=&r" (count),
+      [negative] "=&r" (negative)
+    : [word] "r" (word), [n] "r" (n)
+    : "cc");
+  *available = left;
+  return (int)value;
+}
