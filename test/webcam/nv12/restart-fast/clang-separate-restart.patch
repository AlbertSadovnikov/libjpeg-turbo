+/* Restart-only reader; the original routine above keeps its macro expansion. */
+#undef GET_BYTE
+#define GET_BYTE { \
+  register int c0, c1; \
+  c0 = *buffer++; \
+  c1 = *buffer; \
+  /* Pre-execute most common case */ \
+  get_buffer = (get_buffer << 8) | c0; \
+  bits_left += 8; \
+  if (c0 == 0xFF) { \
+    /* Pre-execute case of FF/00, which represents an FF data byte */ \
+    buffer++; \
+    if (c1 != 0) { \
+      /* Marker lookahead: discard local bit/source/DC state immediately. \
+       * Do not fabricate coefficient bits or consume the marker.  The \
+       * dispatcher clears partial output and replays this MCU slowly. */ \
+      return FALSE; \
+    } \
+  } \
+}
