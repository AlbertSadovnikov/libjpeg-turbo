+      if (!n || n > 10 || l + n > available) return 0;
+      amplitude = (prefix >> (available - l - n)) & ((1U << n) - 1);
+      *value = (int)amplitude;
+      if (amplitude < (1U << (n - 1))) *value -= (1 << n) - 1;
+      *step = (symbol >> 4) + 1;
+      *used += l + n;
+      return 1;
+    }
+    p += count;
+    code = (code + count) << 1;
+  }
+  return 0;
+}
