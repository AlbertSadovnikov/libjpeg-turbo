+/* Four-byte entry: value2[31:24], value1[23:16], run2[15:12],
+ * run1[11:8], pair flag[4], consumed bits[3:0]. Zero denotes fallback.
+ */
+typedef unsigned int multi_entry;
+typedef struct {
+  boolean valid;
+  UINT8 bits[17], huffval[256];
+  multi_entry lookup[1 << MJPEG_FUSED_BITS];
