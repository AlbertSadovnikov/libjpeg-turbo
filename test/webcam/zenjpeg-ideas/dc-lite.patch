+  if (dc < -4096 || dc > 4095) return FALSE;
+  sample = ((dc + 4) >> 3) + 128;
+  if (sample < 0) sample = 0;
+  if (sample > 255) sample = 255;
+  for (y = 0; y < 8; y++) memset(rows[y] + column, sample, 8);
+  return TRUE;
+}
